{
  "scopeName": "source.nacho",
  "name": "nacho",
  "patterns": [
    {
      "begin": "<!--",
      "captures": {
        "0": {
          "name": "punctuation.definition.comment.html"
        }
      },
      "end": "--\\s*>",
      "name": "comment.block.html"
    },
    {
      "match": "^ *#{2} .*$\\n?",
      "name": "entity.name.function.nacho"
    },
    {
      "match": "^ *#{3} .*$\\n?",
      "name": "entity.name.tag.nacho"
    },
    {
      "match": "^ *#{4} .*$\\n?",
      "name": "constant.nacho"
    },
    {
      "match": "^ *#{5} .*$\\n?",
      "name": "string.nacho"
    },
    {
      "match": "^ *#{6} .*$\\n?",
      "name": "storage.nacho"
    },
    {
      "match": "^ *#{7} .*$\\n?",
      "name": "meta.attribute.rust.nacho"
    },
    {
      "match": "^ *#{8,} .*$\\n?",
      "name": "support.constant.nacho"
    },
    {
      "match": "^\\s*\\>(.*)$",
      "name": "storage.class.nacho"
    },
    {
      "match": "(#|//|--) .*",
      "name": "comment.line.number-sign.nacho",
      "captures": {
        "0": {
          "patterns": [
            {
              "name": "punctuation.nacho",
              "match": "\\*(?! )([^*]+)\\*|\\`(?! )([^`]+)\\`|\\\"(?! )([^\"]+)\\\"",
              "captures": {
                "1": {
                  "name": "constant.nacho"
                },
                "2": {
                  "name": "constant.nacho"
                },
                "3": {
                  "name": "constant.nacho"
                }
              }
            }
          ]
        }
      }
    },
    {
      "name": "punctuation.nacho",
      "match": "\\*(?! )([^*]+)\\*|`(?! )([^`]+)`",
      "captures": {
        "1": {
          "name": "variable.nacho"
        },
        "2": {
          "name": "variable.nacho"
        }
      }
    },
    {
      "match": "(?<![\\w.])((0(x|X)[0-9a-fA-F]*)|(([0-9]+\\.?[0-9]*)|(\\.[0-9]+))((e|E)(\\+|-)?[0-9]+)?)(L|l|UL|ul|u|U|F|f|ll|LL|ull|ULL)?\\b",
      "name": "constant.numeric.nacho"
    },
    {
      "match": "<<-|<-|->>|->|=(?!=)",
      "name": "keyword.operator.assignment.nacho"
    },
    {
      "match": "==|!=|<>|<=|>=|<|>",
      "name": "keyword.operator.comparison.nacho"
    },
    {
      "match": "%/%|%%|%\\*%|%in%|%o%|%x%|-|\\+|\\*|/|\\^",
      "name": "keyword.operator.arithmetic.nacho"
    },
    {
      "match": "&&|&|\\|\\||\\||!",
      "name": "keyword.operator.logical.nacho"
    },
    {
      "include": "#string"
    }
  ],
  "repository": {
    "string": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.nacho",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.nacho"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nacho"
            }
          },
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        },
        {
          "begin": "“",
          "end": "”",
          "name": "string.quoted.double.nacho",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.nacho"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nacho"
            }
          },
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        },
        {
          "begin": "«",
          "end": "»",
          "name": "string.quoted.double.nacho",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.nacho"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nacho"
            }
          },
          "patterns": [
            {
              "include": "#string-escape"
            }
          ]
        }
      ]
    },
    "string-escape": {
      "match": "\\\\.",
      "name": "constant.character.escape.nacho"
    }
  }
}
